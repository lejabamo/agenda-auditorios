# ──────────────────────────────────────────────────────────────────────────────
# Agenda Auditorios — Variables de Entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de Datos ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agenda_db
DB_USER=agenda_user
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# ── Seguridad ──────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_SEGURA

# ── CORS ───────────────────────────────────────────────────────────────────────
# En producción: ponle el dominio real del frontend
# Varios dominios separados por coma: https://app.cauca.gov.co,https://www.app.cauca.gov.co
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Correo Electrónico ────────────────────────────────────────────────────────
# --- Opción A: Mailpit (solo para desarrollo local) ---
# MAIL_SERVER=localhost
# MAIL_PORT=1025
# MAIL_USE_TLS=false
# MAIL_USE_SSL=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=sistema@agenda.local

# --- Opción B: Gmail con App Password (producción) ---
# IMPORTANTE: No uses tu contraseña normal de Gmail.
# Ir a: Cuenta Google → Seguridad → Verificación en dos pasos →
#        Contraseñas de aplicaciones → Generar una para "Correo / Windows"
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=tu-cuenta@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx   (App Password de 16 caracteres)
# MAIL_DEFAULT_SENDER=Agenda Auditorios <tu-cuenta@gmail.com>

# --- Opción C: Correo institucional (Exchange / Outlook 365) ---
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=agenda@secretariaeducacion.cauca.gov.co
# MAIL_PASSWORD=CLAVE_INSTITUCIONAL
# MAIL_DEFAULT_SENDER=Agenda Auditorios <agenda@secretariaeducacion.cauca.gov.co>

# ── Notificaciones Admin ───────────────────────────────────────────────────────
ADMIN_NOTIFICATION_EMAIL=leonardo.bastidas@cauca.gov.co

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_APP=app
# En producción debe ser 0 (false). Solo poner 1 en desarrollo local.
FLASK_DEBUG=0
